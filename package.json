{
  "name": "tower-for-college-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Torre 3D: app web que acompaña la planilla «Edificios en torre» (FAUD-UNMDP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
