{
  "name": "tower-for-college-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Torre 3D: app web que acompaña la planilla «Edificios en torre» (FAUD-UNMDP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:unico": "tsc --noEmit && vite build --mode unico && node scripts/clasico.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@ibm/plex-math": "^1.1.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^3.12.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@webgpu/types": "^0.1.51",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.1.1"
  },
  "author": "Augusto Andrés Marsella",
  "license": "SEE LICENSE IN LICENSE",
  "overrides": {
    "image-size": "^2.1.0"
  }
}
